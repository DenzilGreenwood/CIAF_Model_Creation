# CIAF Environment Configuration
# Copy this file to .env and populate with your actual values
# IMPORTANT: .env should NEVER be committed to version control!

# ============================================================
# DATABASE CONFIGURATION
# ============================================================
DB_USER=ciaf_verification
# Generate a strong password for production:
# openssl rand -base64 32
DB_PASSWORD=change_me_to_secure_password_openssl_rand_base64_32

# ============================================================
# REDIS CONFIGURATION
# ============================================================
REDIS_URL=redis://redis:6379/0

# ============================================================
# SECURITY KEYS (GENERATE NEW ONES FOR PRODUCTION)
# ============================================================

# API Key Secret - Used to sign API keys
# Generate: openssl rand -hex 32
API_KEY_SECRET=Bearer dev_api_key_secret_placeholder_generate_with_openssl_rand_hex_32

# JWT Secret Key - Used to sign JWT tokens
# Generate: openssl rand -base64 64
JWT_SECRET_KEY=dev_jwt_placeholder_generate_with_openssl_rand_base64_64

# CIAF API Key - For CIAF Core to CIAF Verification communication
# Generate: openssl rand -hex 32
CIAF_API_KEY=ciaf_core_api_key_placeholder_generate_with_openssl_rand_hex_32

# ============================================================
# ENVIRONMENT CONFIGURATION
# ============================================================
ENVIRONMENT=development
LOG_LEVEL=INFO

# ============================================================
# PGADMIN CONFIGURATION (DEVELOPMENT ONLY)
# ============================================================
PGADMIN_EMAIL=admin@ciaf.local
# For development only - use strong password in production
PGADMIN_PASSWORD=admin_password_dev_change_in_production

# ============================================================
# FRONTEND CONFIGURATION
# ============================================================
VITE_API_BASE_URL=http://localhost:8001
VITE_VERIFICATION_API=http://localhost:8001/verify
VITE_AUDIT_API=http://localhost:8001/audit
VITE_COMPLIANCE_API=http://localhost:8001/compliance
VITE_STATS_API=http://localhost:8001/stats
VITE_HEALTH_API=http://localhost:8001/health

# ============================================================
# APPLICATION SETTINGS
# ============================================================
VITE_APP_NAME=CIAF Verification Dashboard
VITE_APP_VERSION=1.0.0
VITE_NODE_ENV=development

# ============================================================
# PRODUCTION SECURITY CHECKLIST
# ============================================================
# BEFORE deploying to production:
# [ ] Generate all secrets with openssl commands listed above
# [ ] Use HashiCorp Vault or AWS Secrets Manager for secret management
# [ ] Enable HTTPS/TLS for all services
# [ ] Change ENVIRONMENT to production
# [ ] Set LOG_LEVEL to WARN
# [ ] Use strong, unique passwords for all services
# [ ] Implement rate limiting (see documentation)
# [ ] Enable security headers (see documentation)
