# CIAF Verification Dashboard - Environment Configuration

# API Configuration
VITE_API_BASE_URL=http://localhost:8001
VITE_VERIFICATION_API=http://localhost:8001/verify
VITE_AUDIT_API=http://localhost:8001/audit
VITE_COMPLIANCE_API=http://localhost:8001/compliance
VITE_STATS_API=http://localhost:8001/stats
VITE_HEALTH_API=http://localhost:8001/health

# Application Settings
VITE_APP_NAME=CIAF Verification Dashboard
VITE_APP_VERSION=1.0.0
VITE_LOG_LEVEL=info
VITE_NODE_ENV=development

# Authentication
VITE_JWT_STORAGE_KEY=ciaf_jwt_token
VITE_JWT_EXPIRY_MINUTES=60
VITE_REFRESH_TOKEN_EXPIRY_DAYS=7

# UI/UX Settings
VITE_ITEMS_PER_PAGE=25
VITE_CHART_ANIMATION_DURATION=300
VITE_TOAST_DURATION_MS=3000

# Feature Flags
VITE_ENABLE_REAL_TIME_UPDATES=true
VITE_ENABLE_ADVANCED_SEARCH=true
VITE_ENABLE_REPORT_GENERATION=true
VITE_ENABLE_BULK_OPERATIONS=true
VITE_ENABLE_ANALYTICS=false

# Monitoring
VITE_SENTRY_DSN=
VITE_ANALYTICS_ID=
